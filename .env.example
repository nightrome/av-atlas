# Copy this file to .env (gitignored) and fill in your own key.
# Only needed to run fetch_semanticscholar_citing.py / fetch_s2_author_ids.py /
# fetch_orcids.py -- request a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Only needed to run scripts/backup_corpus.py (called automatically by
# scripts/deploy.py, skipped silently if unset) and scripts/restore_corpus.py.
# A fine-grained personal access token scoped to nightrome/av-atlas with
# "Contents" read-and-write permission is enough -- create one at
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
